# Copy to .env and fill in real values. Never commit real values to this file.

# Environment mode (development, production, test)
NODE_ENV=development

# Port number on which the server will run
PORT=4800

# Postgres URL
DATABASE_URL="postgresql://username:password@localhost:5432/kirana?schema=public"

# Secret key used for signing JWT tokens
JWT_SECRET=change_me

# Minutes after which access tokens expire
JWT_ACCESS_EXPIRATION_MINUTES=15

# Days after which refresh tokens expire
JWT_REFRESH_EXPIRATION_DAYS=30

# Minutes after which the reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10

# Minutes after which the email verification token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@example.com

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# Web admin base URL used in verification/reset email links
APP_URL=http://localhost:5173

# Failed auth requests allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

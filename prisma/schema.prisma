generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KIRANA
  EMPLOYEE
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

/// Legacy unit enum, now used only by the global admin catalogue (`Material`, DECISIONS O-6).
enum MaterialUnit {
  KG
  G
  PEICE
  L
  ML
  DOZON
  NOs
}

/// Units for shop products. Conversions live in src/utils/units.ts.
enum UnitCode {
  PIECE
  PACKET
  BOX
  CARTON
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  DAMAGE
  EXPIRY
  ADJUSTMENT
}

model User {
  id                     String                @id @default(uuid())
  username               String                @unique
  email                  String                @unique
  fullname               String
  password               String
  refreshToken           String?
  verifyCode             String?
  verifyCodeExpiry       DateTime?
  isVerified             Boolean               @default(false)
  isActive               Boolean               @default(true)
  phoneNumber            String
  secondaryPhoneNumber   String?
  role                   Role                  @default(KIRANA)
  // single-use password reset: only a SHA-256 hash is stored
  passwordResetTokenHash String?               @unique
  passwordResetExpiry    DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  kirana                 kirana?
  employee               employee?
  memberships            Membership[]
  sessions               Session[]
  stockMovements         StockMovement[]
  priceChanges           ProductPriceChange[]
  heldBills              HeldBill[]
  sales                  Sale[]
  saleReturns            SaleReturn[]
  customerEntries        CustomerLedgerEntry[]
  customerPayments       CustomerPayment[]
}

/// One login session per device. The refresh token is opaque; only its SHA-256 hash is stored.
model Session {
  id               String    @id @default(uuid())
  userId           String
  kiranaId         String?
  storeId          String?
  refreshTokenHash String
  deviceName       String?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// A user's role in one business (tenant). Platform ADMIN stays on User.role.
model Membership {
  id        String         @id @default(uuid())
  userId    String
  kiranaId  String
  role      MembershipRole
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  kirana    kirana         @relation(fields: [kiranaId], references: [id])

  @@unique([userId, kiranaId])
  @@index([kiranaId])
}

/// A physical shop. MVP: exactly one default store per business, created with it.
model Store {
  id               String            @id @default(uuid())
  kiranaId         String
  name             String
  address          String?
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  kirana           kirana            @relation(fields: [kiranaId], references: [id])
  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  heldBills        HeldBill[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  series           DocumentSeries[]
  customerPayments CustomerPayment[]

  @@index([kiranaId])
}

model kirana {
  id               String                   @id @default(uuid())
  userId           String                   @unique
  name             String
  address          String
  City             String
  gstin            String?
  gstScheme        GstScheme                @default(UNREGISTERED)
  roundOff         RoundOffRule             @default(NEAREST_1)
  invoicePrefix    String                   @default("INV")
  upiId            String? // the shop's UPI ID (VPA) for the static checkout QR (O-10)
  amount           Decimal                  @default(0)
  renewalAmount    Decimal                  @default(0)
  // languageId       String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id])
  employee         employee[]
  materialCategory KiranaMaterialCategory[]
  material         KiranaMaterial[]
  client           client[]
  order            order[]
  purchaseOrder    purchaseOrder[]
  stores           Store[]
  memberships      Membership[]
  brands           Brand[]
  heldBills        HeldBill[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  customerEntries  CustomerLedgerEntry[]
  customerBalances CustomerBalance[]
  customerPayments CustomerPayment[]
}

model employee {
  id       String @id @default(uuid())
  userId   String @unique
  kiranaId String
  address  String
  kirana   kirana @relation(fields: [kiranaId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model MaterialCategory {
  id       String     @id @default(uuid())
  name     String     @unique
  material Material[]
}

model Material {
  id         String           @id @default(uuid())
  name       String           @unique
  inventory  Int              @default(0)
  unit       MaterialUnit
  barcode    String           @unique
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model KiranaMaterialCategory {
  id       String           @id @default(uuid())
  name     String
  kiranaId String
  kirana   kirana           @relation(fields: [kiranaId], references: [id])
  material KiranaMaterial[]

  @@unique([kiranaId, name])
}

model Brand {
  id        String           @id @default(uuid())
  kiranaId  String
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  kirana    kirana           @relation(fields: [kiranaId], references: [id])
  products  KiranaMaterial[]

  @@unique([kiranaId, name])
}

/// A shop product. Quantities are in `baseUnit`. `sellingPrice`/`mrp` are per `salesUnit` and
/// `purchaseCost` per `purchaseUnit`. Stock lives in the ledger (StockMovement), never on this row.
model KiranaMaterial {
  id                String                  @id @default(uuid())
  kiranaId          String
  name              String
  sku               String?
  status            ProductStatus           @default(ACTIVE)
  categoryId        String?
  brandId           String?
  baseUnit          UnitCode
  salesUnit         UnitCode
  purchaseUnit      UnitCode
  sellingPrice      Decimal?                @db.Decimal(14, 2)
  mrp               Decimal?                @db.Decimal(14, 2)
  purchaseCost      Decimal?                @db.Decimal(14, 2)
  hsnCode           String?
  gstRate           Decimal?                @db.Decimal(5, 2)
  priceIncludesTax  Boolean                 @default(true)
  isFavourite       Boolean                 @default(false)
  lowStockThreshold Decimal?                @db.Decimal(14, 3)
  kirana            kirana                  @relation(fields: [kiranaId], references: [id])
  category          KiranaMaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  units             ProductUnit[]
  barcodes          ProductBarcode[]
  aliases           ProductAlias[]
  priceChanges      ProductPriceChange[]
  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  saleLines         SaleLine[]
  orderItem         orderItem[]
  purchaseOrderItem purchaseOrderItem[]

  @@unique([kiranaId, name])
  @@unique([kiranaId, sku])
  @@index([kiranaId, status])
}

/// Extra units besides the base unit. `factor` = base units in one of this unit.
model ProductUnit {
  id        String         @id @default(uuid())
  productId String
  unit      UnitCode
  factor    Decimal        @db.Decimal(18, 6)
  product   KiranaMaterial @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unit])
}

/// Barcodes are unique per business; `unit` is what one scan means (base unit or a ProductUnit).
model ProductBarcode {
  id        String         @id @default(uuid())
  kiranaId  String
  productId String
  code      String
  unit      UnitCode
  createdAt DateTime       @default(now())
  product   KiranaMaterial @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kiranaId, code])
  @@index([productId])
}

/// Search names, e.g. local-language names.
model ProductAlias {
  id        String         @id @default(uuid())
  productId String
  alias     String
  product   KiranaMaterial @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
}

/// Append-only snapshot of price, cost and tax fields, written on create and on every change.
model ProductPriceChange {
  id               String         @id @default(uuid())
  kiranaId         String
  productId        String
  salesUnit        UnitCode
  sellingPrice     Decimal?       @db.Decimal(14, 2)
  mrp              Decimal?       @db.Decimal(14, 2)
  purchaseUnit     UnitCode
  purchaseCost     Decimal?       @db.Decimal(14, 2)
  hsnCode          String?
  gstRate          Decimal?       @db.Decimal(5, 2)
  priceIncludesTax Boolean
  effectiveFrom    DateTime       @default(now())
  changedById      String
  product          KiranaMaterial @relation(fields: [productId], references: [id])
  changedBy        User           @relation(fields: [changedById], references: [id])

  @@index([productId, effectiveFrom])
}

/// Append-only stock ledger. `quantity` is signed and in the product's base unit. No updates or deletes.
model StockMovement {
  id              String            @id @default(uuid())
  kiranaId        String
  storeId         String
  productId       String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  balanceAfter    Decimal           @db.Decimal(14, 3)
  enteredQuantity Decimal           @db.Decimal(14, 3)
  enteredUnit     UnitCode
  unitCost        Decimal?          @db.Decimal(14, 2)
  reason          String?
  reference       String?
  idempotencyKey  String?
  actorId         String
  createdAt       DateTime          @default(now())
  product         KiranaMaterial    @relation(fields: [productId], references: [id])
  store           Store             @relation(fields: [storeId], references: [id])
  actor           User              @relation(fields: [actorId], references: [id])
  saleLine        SaleLine?
  returnRestock   SaleReturnLine?   @relation("ReturnRestock")
  returnDamage    SaleReturnLine?   @relation("ReturnDamage")

  @@unique([kiranaId, idempotencyKey])
  @@index([kiranaId, storeId, productId, createdAt])
}

/// Read model: the sum of a product's movements in a store, updated in the same transaction.
model StockBalance {
  id        String         @id @default(uuid())
  kiranaId  String
  storeId   String
  productId String
  quantity  Decimal        @db.Decimal(14, 3)
  updatedAt DateTime       @updatedAt
  product   KiranaMaterial @relation(fields: [productId], references: [id])
  store     Store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, productId])
  @@index([kiranaId])
}

model client {
  id                  String                @id @default(uuid())
  name                String
  address             String
  phoneNumber         String
  kiranaId            String
  kirana              kirana                @relation(fields: [kiranaId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  order               order[]
  clientWallet        clientWallet?
  clientWalletHistory clientWalletHistory[]
  heldBills           HeldBill[]
  sales               Sale[]
  ledgerEntries       CustomerLedgerEntry[]
  balance             CustomerBalance?
  // Phase 5 (A-031). A phone may be shared by a family, so it is not unique; the service refuses
  // the same name on the same phone and asks before adding a second name to one.
  notes               String?
  tags                String[]              @default([])
  creditLimit         Decimal?              @db.Decimal(14, 2) // null: no limit
  isActive            Boolean               @default(true) // archived customers take no new bills
  payments            CustomerPayment[]

  @@index([kiranaId, phoneNumber])
}

model order {
  id                    String                @id @default(uuid())
  clientId              String
  client                client                @relation(fields: [clientId], references: [id])
  kiranaId              String
  kirana                kirana                @relation(fields: [kiranaId], references: [id])
  createdAt             DateTime              @default(now())
  totalPrice            Float
  paid                  Float
  updatedAt             DateTime              @updatedAt
  orderItem             orderItem[]
  clientWalletHistories clientWalletHistory[]
}

model orderItem {
  id         String         @id @default(uuid())
  orderId    String
  quantity   Int
  price      Float
  order      order          @relation(fields: [orderId], references: [id])
  materialId String
  material   KiranaMaterial @relation(fields: [materialId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([orderId, materialId])
}

model clientWallet {
  id                    String                @id @default(uuid())
  clientId              String                @unique
  client                client                @relation(fields: [clientId], references: [id])
  amount                Float
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  clientWalletHistories clientWalletHistory[]
}

enum HistoryType {
  DEBIT
  CREDIT
}

model clientWalletHistory {
  id             String       @id @default(uuid())
  clientId       String
  orderId        String?
  type           HistoryType
  order          order?       @relation(fields: [orderId], references: [id])
  clientWalletId String
  clientWallet   clientWallet @relation(fields: [clientWalletId], references: [id])
  client         client       @relation(fields: [clientId], references: [id])
  amount         Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model purchaseOrder {
  id                String              @id @default(uuid())
  kiranaId          String
  kirana            kirana              @relation(fields: [kiranaId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  purchaseOrderItem purchaseOrderItem[]
}

model purchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   purchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  materialId      String
  material        KiranaMaterial @relation(fields: [materialId], references: [id])
  quantity        Int
  price           Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([purchaseOrderId, materialId])
}

/// A parked POS cart. A draft snapshot, never a sale: it writes no stock, order or revenue rows.
model HeldBill {
  id             String    @id @default(uuid())
  kiranaId       String
  storeId        String
  createdById    String
  customerId     String?
  note           String?
  lines          Json
  createdAt      DateTime  @default(now())
  /// Makes a retried hold return the first bill instead of a duplicate.
  idempotencyKey String?
  /// Recall claims the bill for one till; the till deletes it once it is in its cart.
  claimKey       String?
  claimedAt      DateTime?
  /// Set when the claiming till confirms; the row is kept so a late confirm from another till gets 409.
  recalledAt     DateTime?
  kirana         kirana    @relation(fields: [kiranaId], references: [id])
  store          Store     @relation(fields: [storeId], references: [id])
  createdBy      User      @relation(fields: [createdById], references: [id])
  customer       client?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([kiranaId, idempotencyKey])
  @@index([kiranaId, storeId, createdAt])
}

// ---- Phase 4: sales, payments, invoices and returns (DECISIONS A-030) ----

enum GstScheme {
  UNREGISTERED // no tax on the bill
  REGULAR // tax invoice: CGST + SGST from each product's gstRate (intra-state counter sale)
  COMPOSITION // bill of supply: no tax charged on the bill
}

enum RoundOffRule {
  NONE
  NEAREST_1 // the payable total is rounded half up to the rupee; the difference is a round-off line
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT // customer udhaar: posts a CustomerLedgerEntry
}

/// RECORDED: the cashier says it was paid. CONFIRMED is reserved for a trusted gateway or acquirer
/// integration (O-10); nothing in the MVP sets it, so UPI is never shown as bank-confirmed.
enum PaymentStatus {
  RECORDED
  CONFIRMED
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
  PAYMENT_RECEIPT // a customer collection: RCPT/26-27/00001
}

enum ReturnDisposition {
  RESTOCK // back on the shelf: SALE_RETURN movement
  DAMAGED // SALE_RETURN then DAMAGE, so the ledger shows both
}

enum CustomerEntryType {
  CREDIT_SALE // + the customer owes more
  RETURN_CREDIT // - a return refunded to the customer's account
  OPENING_BALANCE // +/- carried over from the shop's old book, once per customer
  PAYMENT // - a collection (CustomerPayment)
  ADJUSTMENT // +/- an approved correction, with a reason
  REVERSAL // the exact opposite of one earlier entry, with a reason
}

/// Gapless numbers per store, document kind and financial year (April-March, IST). The counter row is
/// incremented inside the sale transaction, so a rolled-back sale gives its number back.
model DocumentSeries {
  id            String       @id @default(uuid())
  kiranaId      String
  storeId       String
  kind          DocumentKind
  financialYear String // "2026-27"
  next          Int          @default(1)
  store         Store        @relation(fields: [storeId], references: [id])

  @@unique([storeId, kind, financialYear])
}

/// A completed sale (the invoice). Immutable: returns are separate records and never change it.
model Sale {
  id             String                      @id @default(uuid())
  kiranaId       String
  storeId        String
  invoiceNo      String
  financialYear  String
  sequence       Int
  customerId     String?
  cashierId      String
  // Seller snapshot, so a reprint shows what the bill showed then.
  gstScheme      GstScheme
  sellerName     String
  sellerAddress  String?
  sellerGstin    String?
  subtotal       Decimal                     @db.Decimal(14, 2) // sum of line gross
  discountTotal  Decimal                     @db.Decimal(14, 2)
  taxableTotal   Decimal                     @db.Decimal(14, 2)
  cgstTotal      Decimal                     @db.Decimal(14, 2)
  sgstTotal      Decimal                     @db.Decimal(14, 2)
  roundOff       Decimal                     @db.Decimal(14, 2)
  total          Decimal                     @db.Decimal(14, 2) // payable
  changeDue      Decimal                     @db.Decimal(14, 2) // cash handed back
  note           String?
  idempotencyKey String
  createdAt      DateTime                    @default(now())
  kirana         kirana                      @relation(fields: [kiranaId], references: [id])
  store          Store                       @relation(fields: [storeId], references: [id])
  customer       client?                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier        User                        @relation(fields: [cashierId], references: [id])
  lines          SaleLine[]
  payments       SalePayment[]
  returns        SaleReturn[]
  ledgerEntries  CustomerLedgerEntry[]
  allocations    CustomerPaymentAllocation[]

  @@unique([kiranaId, idempotencyKey])
  @@unique([storeId, invoiceNo])
  @@index([kiranaId, storeId, createdAt])
}

/// A line as billed: price, discount and tax are snapshots and never recalculated.
model SaleLine {
  id               String           @id @default(uuid())
  saleId           String
  lineNo           Int
  productId        String
  productName      String
  sku              String?
  hsnCode          String?
  unit             UnitCode
  factor           Decimal          @db.Decimal(18, 6)
  quantity         Decimal          @db.Decimal(14, 3) // in `unit`
  unitPrice        Decimal          @db.Decimal(14, 2) // per `unit`, for display
  gross            Decimal          @db.Decimal(14, 2)
  discount         Decimal          @db.Decimal(14, 2)
  priceOverridden  Boolean
  priceIncludesTax Boolean
  gstRate          Decimal          @db.Decimal(5, 2) // 0 unless the sale was REGULAR
  taxableValue     Decimal          @db.Decimal(14, 2)
  cgst             Decimal          @db.Decimal(14, 2)
  sgst             Decimal          @db.Decimal(14, 2)
  total            Decimal          @db.Decimal(14, 2) // payable for the line, tax included
  stockMovementId  String?          @unique
  sale             Sale             @relation(fields: [saleId], references: [id])
  product          KiranaMaterial   @relation(fields: [productId], references: [id])
  stockMovement    StockMovement?   @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  returnLines      SaleReturnLine[]

  @@unique([saleId, lineNo])
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2) // allocated to the bill
  tendered  Decimal?      @db.Decimal(14, 2) // CASH only: what the customer handed over
  reference String? // UPI ref, card slip or bank reference, as typed
  status    PaymentStatus @default(RECORDED)
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

/// A partial or full return against one sale, with its own credit-note number.
model SaleReturn {
  id             String                @id @default(uuid())
  kiranaId       String
  storeId        String
  saleId         String
  creditNoteNo   String
  financialYear  String
  sequence       Int
  reason         String
  refundMethod   PaymentMethod
  refundTotal    Decimal               @db.Decimal(14, 2) // after round-off
  roundOff       Decimal               @db.Decimal(14, 2)
  createdById    String
  idempotencyKey String
  createdAt      DateTime              @default(now())
  kirana         kirana                @relation(fields: [kiranaId], references: [id])
  store          Store                 @relation(fields: [storeId], references: [id])
  sale           Sale                  @relation(fields: [saleId], references: [id])
  createdBy      User                  @relation(fields: [createdById], references: [id])
  lines          SaleReturnLine[]
  ledgerEntries  CustomerLedgerEntry[]

  @@unique([kiranaId, idempotencyKey])
  @@unique([storeId, creditNoteNo])
  @@index([saleId])
}

model SaleReturnLine {
  id                String            @id @default(uuid())
  returnId          String
  saleLineId        String
  quantity          Decimal           @db.Decimal(14, 3) // in the sale line's unit
  disposition       ReturnDisposition
  taxableValue      Decimal           @db.Decimal(14, 2)
  cgst              Decimal           @db.Decimal(14, 2)
  sgst              Decimal           @db.Decimal(14, 2)
  amount            Decimal           @db.Decimal(14, 2) // refund for the line, tax included
  restockMovementId String?           @unique
  damageMovementId  String?           @unique
  saleReturn        SaleReturn        @relation(fields: [returnId], references: [id])
  saleLine          SaleLine          @relation(fields: [saleLineId], references: [id])
  restockMovement   StockMovement?    @relation("ReturnRestock", fields: [restockMovementId], references: [id], onDelete: Restrict)
  damageMovement    StockMovement?    @relation("ReturnDamage", fields: [damageMovementId], references: [id], onDelete: Restrict)
}

/// Append-only customer account (udhaar). Phase 5 adds payments received, statements and limits.
model CustomerLedgerEntry {
  id             String               @id @default(uuid())
  kiranaId       String
  customerId     String
  type           CustomerEntryType
  amount         Decimal              @db.Decimal(14, 2) // signed: + the customer owes more
  balanceAfter   Decimal              @db.Decimal(14, 2)
  saleId         String?
  saleReturnId   String?
  paymentId      String?
  reversesId     String?              @unique // a REVERSAL points at the entry it cancels; once only
  reason         String? // required for OPENING_BALANCE, ADJUSTMENT, REVERSAL and an over-limit sale
  idempotencyKey String? // for entries posted directly (opening, adjustment, reversal)
  actorId        String
  createdAt      DateTime             @default(now())
  kirana         kirana               @relation(fields: [kiranaId], references: [id])
  customer       client               @relation(fields: [customerId], references: [id])
  sale           Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn     SaleReturn?          @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  payment        CustomerPayment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses       CustomerLedgerEntry? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     CustomerLedgerEntry? @relation("Reversal")
  actor          User                 @relation(fields: [actorId], references: [id])

  @@unique([kiranaId, idempotencyKey])
  @@index([kiranaId, customerId, createdAt])
  @@index([paymentId])
}

/// A collection from a customer (udhaar paid back). Immutable: a mistake is undone by reversing its
/// PAYMENT ledger entry, after which its allocations no longer count against invoice dues.
model CustomerPayment {
  id             String                      @id @default(uuid())
  kiranaId       String
  storeId        String
  customerId     String
  receiptNo      String // RCPT/26-27/00001
  financialYear  String
  sequence       Int
  method         PaymentMethod // never CREDIT
  amount         Decimal                     @db.Decimal(14, 2)
  reference      String? // UPI ref, cheque or bank reference, as typed
  receivedOn     DateTime                    @db.Date // the IST day the money came in
  note           String?
  status         PaymentStatus               @default(RECORDED)
  idempotencyKey String
  createdById    String
  createdAt      DateTime                    @default(now())
  kirana         kirana                      @relation(fields: [kiranaId], references: [id])
  store          Store                       @relation(fields: [storeId], references: [id])
  customer       client                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      User                        @relation(fields: [createdById], references: [id])
  allocations    CustomerPaymentAllocation[]
  ledgerEntries  CustomerLedgerEntry[]

  @@unique([kiranaId, idempotencyKey])
  @@unique([storeId, receiptNo])
  @@index([kiranaId, customerId, createdAt])
}

/// The part of a collection set against one credit invoice. What is left unallocated is on account.
model CustomerPaymentAllocation {
  id        String          @id @default(uuid())
  paymentId String
  saleId    String
  amount    Decimal         @db.Decimal(14, 2)
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([paymentId, saleId])
  @@index([saleId])
}

/// Running balance per customer, moved only together with a CustomerLedgerEntry (row-locked upsert).
model CustomerBalance {
  id         String   @id @default(uuid())
  kiranaId   String
  customerId String   @unique
  balance    Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt
  kirana     kirana   @relation(fields: [kiranaId], references: [id])
  customer   client   @relation(fields: [customerId], references: [id])

  @@index([kiranaId])
}
